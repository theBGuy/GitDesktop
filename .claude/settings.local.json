{
  "permissions": {
    "allow": [
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "PowerShell(pnpm lint)",
      "PowerShell(pnpm exec tsc -b)",
      "PowerShell(cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings)",
      "Bash(cargo check *)",
      "Bash(pnpm build *)",
      "Bash(pnpm lint *)",
      "Bash(git --no-pager diff --name-only)",
      "PowerShell(pnpm build 2>&1)",
      "PowerShell(pnpm lint 2>&1)",
      "Bash(pnpm build)",
      "Bash(pnpm build:*)",
      "Bash(pnpm exec biome check:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(git --no-pager diff)",
      "Bash(git --no-pager diff:*)",
      "Bash(git --no-pager status)",
      "Bash(git --no-pager status:*)",
      "Bash(git --no-pager log)",
      "Bash(git --no-pager log:*)",
      "Bash(git --no-pager show:*)",
      "Bash(git branch --list)",
      "Bash(git branch --list:*)",
      "Bash(cd site && pnpm build)",
      "PowerShell(pnpm build)",
      "PowerShell(pnpm build:*)",
      "PowerShell(pnpm exec biome check:*)",
      "PowerShell(pnpm exec tsc:*)",
      "PowerShell(cargo test:*)",
      "PowerShell(cargo clippy:*)",
      "PowerShell(git --no-pager diff)",
      "PowerShell(git --no-pager diff:*)",
      "PowerShell(git --no-pager status)",
      "PowerShell(git --no-pager status:*)",
      "PowerShell(git --no-pager log)",
      "PowerShell(git --no-pager log:*)",
      "PowerShell(git --no-pager show:*)",
      "PowerShell(cd site && pnpm build)",
      "Bash(git --no-pager diff *)",
      "mcp__gitdesktop__repo_status",
      "mcp__gitdesktop__list_pull_requests",
      "mcp__gitdesktop__list_pull_request_comments",
      "mcp__gitdesktop__comment_pull_request"
    ]
  },
  "enabledMcpjsonServers": [
    "shadcn",
    "Astro docs"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: runs after Edit/Write/MultiEdit on UI files and surfaces findings as system reminders."
}
