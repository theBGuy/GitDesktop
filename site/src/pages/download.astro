---
import { Image } from "astro:assets";
import appStaging from "../assets/app-staging.png";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  assetBySuffix,
  formatReleaseDate,
  getLatestRelease,
} from "../lib/release";

const repo = "https://github.com/theBGuy/GitDesktop";
const releases = `${repo}/releases`;

// Release facts are baked at build time (lib/release.ts: guarded live fetch,
// package.json fallback) so version, date, and direct asset links exist as real
// text for crawlers and no-JS visitors. The client script below still re-points
// everything at the actual latest release, so a deploy that lags a release
// self-corrects for JS visitors.
const rel = await getLatestRelease();

const buildTargets: {
  id: string;
  os: string;
  detail: string;
  suffix: string;
  cmd?: string;
}[] = [
  {
    id: "dl-win",
    os: "Windows",
    detail: "Installer .exe · x64",
    suffix: "-setup.exe",
  },
  {
    id: "dl-mac",
    os: "macOS",
    detail: ".dmg · Apple Silicon & Intel (universal)",
    suffix: ".dmg",
    cmd: "brew install --cask thebguy/tap/gitdesktop",
  },
  {
    id: "dl-linux-appimage",
    os: "Linux",
    detail: "AppImage · x64 · portable",
    suffix: ".AppImage",
  },
  {
    id: "dl-linux-deb",
    os: "Linux",
    detail: "Debian .deb · x64 · apt-based",
    suffix: ".deb",
  },
  {
    id: "dl-linux-rpm",
    os: "Linux",
    detail: "Fedora .rpm · x64 · dnf-based",
    suffix: ".rpm",
  },
];

const builds = buildTargets.map((b) => ({
  ...b,
  href: assetBySuffix(rel, b.suffix) ?? releases,
}));

const releasedOn = rel.publishedAt
  ? ` (${formatReleaseDate(rel.publishedAt)})`
  : "";

// Descriptive entity data only — deliberately no aggregateRating/review (no
// honest rating source exists, and fabricating one violates structured-data
// policy), which also means no rich-result eligibility. That's the accepted
// trade-off.

// The trailing replace is the same < escape as Head.astro's graph;
// rel.version is external build-time data (the live GitHub API, or
// package.json on the fallback path — hence the rel.live gate below).
const softwareLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "GitDesktop",
  operatingSystem: "Windows, macOS, Linux",
  applicationCategory: "DeveloperApplication",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  // Only from live data — the fallback's package.json version can be ahead of
  // the published release during the release:prepare window.
  ...(rel.live && { softwareVersion: rel.version }),
  downloadUrl: "https://gitdesktop.app/download/",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  url: "https://gitdesktop.app/",
  sameAs: "https://github.com/theBGuy/GitDesktop",
}).replace(/</g, "\\u003c");
---

<SiteLayout
  title="Download GitDesktop for Windows, macOS & Linux"
  description="Free, open-source native builds of GitDesktop for Windows, macOS, and Linux — installer, .dmg (or Homebrew), AppImage, .deb and .rpm, with signed auto-updates."
  ogTitle="Download GitDesktop"
  ogDescription="Free and open source, for Windows, macOS and Linux."
  breadcrumbs={[{ name: "Download", path: "/download/" }]}
>
  <section class="border-b border-line">
    <div
      class="mx-auto grid max-w-6xl items-center gap-x-12 gap-y-12 px-5 py-16 md:py-20 lg:grid-cols-[1fr_1.05fr]"
    >
      <div class="min-w-0">
        <p class="text-sm text-faint"><span class="text-add">//</span> download</p>
        <h1 class="mt-5 text-[clamp(2rem,5vw,3rem)] font-semibold tracking-tight">
          Get GitDesktop.
        </h1>
        <p class="mt-6 max-w-[56ch] text-base leading-relaxed text-body sm:text-lg">
          Native installers for Windows, macOS, and Linux. Free, open-source, and
          self-updating after install.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            id="primary-dl"
            href={releases}
            class="inline-flex items-center gap-2 rounded-lg bg-mint px-5 py-2.5 font-medium text-mint-ink transition-opacity hover:opacity-90"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3v12m0 0l-4-4m4 4l4-4"></path>
              <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path>
            </svg>
            <span data-label>Download</span>
          </a>
          <a
            href={repo}
            class="rounded-lg border border-line-2 px-5 py-2.5 font-medium text-ink transition-colors hover:bg-surface"
            >View source</a
          >
        </div>
        <p id="dl-meta" class="mt-6 text-sm text-muted">
          {rel.live ? `${rel.tag}${releasedOn} · ` : ""}Free · Windows, macOS &amp; Linux
        </p>
      </div>

      <div class="min-w-0">
        <figure class="window">
          <Image
            src={appStaging}
            alt="What you're installing: GitDesktop staging a diff hunk by hunk, with the changes list and stash browser beside it"
            widths={[600, 900, 1296]}
            sizes="(min-width: 1024px) 580px, 92vw"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14 md:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr]">
      <div>
        <h2 class="text-sm font-normal tracking-normal text-faint">all builds</h2>
        <ul class="mt-5 border-y border-line">
          {
            builds.map((b) => (
              <li class="flex items-center justify-between gap-4 border-line py-4 not-last:border-b">
                <div class="min-w-0">
                  <p class="font-medium text-ink">{b.os}</p>
                  <p class="text-sm text-muted">{b.detail}</p>
                  {/* select-all makes one tap grab the whole command; the
                      nowrap + own-axis scroll keeps it inside the row on
                      narrow viewports instead of wrapping mid-command. */}
                  {b.cmd && (
                    <code
                      class="mt-1.5 block w-fit max-w-full select-all overflow-x-auto whitespace-nowrap rounded border border-line bg-surface/60 px-2 py-1 font-mono text-xs text-ink"
                      role="region"
                      aria-label="Homebrew install command"
                      tabindex="0"
                    >
                      {b.cmd}
                    </code>
                  )}
                </div>
                <a
                  id={b.id}
                  href={b.href}
                  class="shrink-0 rounded-md border border-line-2 px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-surface"
                >
                  Download
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-sm text-muted">
          Latest builds, checksums, and release notes live on
          <a href={releases} class="text-mint underline-offset-4 hover:underline">GitHub Releases</a>.
        </p>
      </div>

      <aside class="self-start rounded-lg border border-line bg-surface/40 p-6 text-sm">
        <h2 class="text-sm font-normal tracking-normal text-faint">requires</h2>
        <ul class="mt-4 space-y-3 leading-relaxed text-body">
          <li>
            <span class="text-ink">Windows 10+</span>,
            <span class="text-ink">macOS 11+</span>, or a modern Linux desktop
            (webkit2gtk).
          </li>
          <li>
            <span class="text-ink">Git</span>, plus your forge's CLI —
            <span class="text-ink">gh</span> for GitHub,
            <span class="text-ink">glab</span> for GitLab. Both run through your
            existing CLI auth; GitDesktop never stores those tokens.
          </li>
          <li>
            <span class="text-ink">Bitbucket Cloud</span> and
            <span class="text-ink">Jira</span> connect with an Atlassian API
            token, held in your OS keychain.
          </li>
          <li>
            Updates are <span class="text-ink">signed and verified</span>,
            installed only on your consent.
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={softwareLd} />

  <script is:inline>
    // Detect the visitor's OS to label the primary button, then fetch the latest
    // release and point each button at its matching asset. The baked build-time
    // links keep working if this never runs (no JS, rate-limited, offline).
    (function () {
      var OWNER = "theBGuy";
      var REPO = "GitDesktop";
      var ua = navigator.userAgent || "";
      var plat =
        (navigator.userAgentData && navigator.userAgentData.platform) ||
        navigator.platform ||
        "";
      var hay = plat + " " + ua;
      var os = /Win/i.test(hay)
        ? "windows"
        : /Mac/i.test(hay)
          ? "macos"
          : /Linux|X11/i.test(hay) && !/Android/i.test(ua)
            ? "linux"
            : "other";

      var primary = document.getElementById("primary-dl");
      var label = primary && primary.querySelector("[data-label]");
      var labels = {
        windows: "Download for Windows",
        macos: "Download for macOS",
        linux: "Download for Linux",
        other: "Download",
      };
      if (label) label.textContent = labels[os];

      var rowSuffix = {
        "dl-win": "-setup.exe",
        "dl-mac": ".dmg",
        "dl-linux-appimage": ".AppImage",
        "dl-linux-deb": ".deb",
        "dl-linux-rpm": ".rpm",
      };
      var primarySuffix = {
        windows: "-setup.exe",
        macos: ".dmg",
        linux: ".AppImage",
      };

      fetch(
        "https://api.github.com/repos/" + OWNER + "/" + REPO + "/releases/latest",
        { headers: { Accept: "application/vnd.github+json" } }
      )
        .then(function (r) {
          if (!r.ok) throw 0;
          return r.json();
        })
        .then(function (rel) {
          var assets = rel.assets || [];
          function find(suffix) {
            for (var i = 0; i < assets.length; i++) {
              var n = assets[i].name || "";
              if (
                n.length >= suffix.length &&
                n.slice(-suffix.length) === suffix &&
                n.indexOf(".sig") === -1
              ) {
                return assets[i].browser_download_url;
              }
            }
            return null;
          }
          Object.keys(rowSuffix).forEach(function (id) {
            var el = document.getElementById(id);
            var url = find(rowSuffix[id]);
            if (el && url) el.href = url;
          });
          var meta = document.getElementById("dl-meta");
          if (meta && rel.tag_name) {
            var when = "";
            if (rel.published_at) {
              try {
                when =
                  " (" +
                  new Date(rel.published_at).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                    timeZone: "UTC",
                  }) +
                  ")";
              } catch (e) {}
            }
            meta.textContent =
              rel.tag_name + when + " · Free · Windows, macOS & Linux";
          }
          if (primary && primarySuffix[os]) {
            var purl = find(primarySuffix[os]);
            if (purl) primary.href = purl;
          }
        })
        .catch(function () {
          /* No release yet / rate-limited / offline — the baked links stand. */
        });
    })();
  </script>
</SiteLayout>
