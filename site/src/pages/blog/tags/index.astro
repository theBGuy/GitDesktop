---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getTags, tagUrl } from "../../../lib/posts";

const base = import.meta.env.BASE_URL;
const tags = await getTags();
---

<SiteLayout
  active="blog"
  feed
  title="Topics — GitDesktop blog"
  description="Every topic covered on the GitDesktop blog: git internals, the pull-request loop, multi-forge parity, Tauri, and optional AI."
  ogTitle="Blog topics"
  ogDescription="Everything the GitDesktop blog covers, by topic."
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-5 py-14 md:py-16">
      <a
        href={`${base}blog/`}
        class="text-sm text-faint transition-colors hover:text-muted"
      >
        <span class="text-add">//</span> blog
      </a>
      <h1 class="mt-5 text-[clamp(1.75rem,4vw,2.75rem)] font-semibold tracking-tight">
        Topics
      </h1>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-5 py-6 md:py-10">
      {
        tags.length === 0 ? (
          <p class="py-16 text-center text-muted">No topics yet.</p>
        ) : (
          <ul class="divide-y divide-line border-y border-line">
            {tags.map(({ tag, count }) => (
              <li>
                <a
                  href={tagUrl(tag)}
                  class="group flex items-baseline justify-between gap-6 py-5"
                >
                  <span class="text-ink underline decoration-line-2 underline-offset-4 transition-colors group-hover:decoration-mint">
                    {tag}
                  </span>
                  <span class="text-sm text-muted">
                    {count} {count === 1 ? "post" : "posts"}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</SiteLayout>
