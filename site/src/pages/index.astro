---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}app-icon.svg`} />
    <title>GitDesktop — the whole GitHub loop in one native app</title>
    <meta
      name="description"
      content="A native desktop client for GitHub: staging and diffs, the full pull-request loop with code review, Actions, and issues — in one window, with optional AI you fully control, or hide entirely."
    />
    <meta property="og:title" content="GitDesktop — the whole GitHub loop, one native app" />
    <meta
      property="og:description"
      content="GitHub Desktop fundamentals plus the full pull-request loop, code review, Actions, and issues — in one fast, native window. With AI you control, or hide entirely."
    />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Set the view mode before first paint (no flash). ?ai=off or a stored
      // preference shows the "Just Git" view; default is AI-native.
      (function () {
        try {
          var ai = new URLSearchParams(location.search).get("ai");
          var stored = localStorage.getItem("gd-view");
          if (ai === "off" || ai === "0" || (ai == null && stored === "git")) {
            document.documentElement.classList.add("mode-git");
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // Reveal-on-scroll that enhances an already-visible default. With no JS,
      // or with reduced-motion, everything stays visible.
      (function () {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (location.search.indexOf("still") !== -1) return; // screenshot hook
        document.documentElement.classList.add("js");
        function revealAll() {
          document
            .querySelectorAll("[data-reveal]")
            .forEach(function (el) { el.classList.add("is-visible"); });
        }
        if (!("IntersectionObserver" in window)) { revealAll(); return; }
        addEventListener("DOMContentLoaded", function () {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add("is-visible");
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.04 }
          );
          document
            .querySelectorAll("[data-reveal]")
            .forEach(function (el) { io.observe(el); });
          setTimeout(revealAll, 1800); // safety: never ship a blank section
        });
      })();
    </script>
  </head>

  <body class="min-h-screen antialiased">
    <!-- Nav -->
    <header class="sticky top-0 z-30 border-b border-line bg-bg/80 backdrop-blur-md">
      <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-3 px-5">
        <a href="#top" class="flex items-center gap-2.5 font-medium text-ink">
          <img src={`${base}app-icon.svg`} alt="" width="22" height="22" />
          <span class="hidden sm:inline">GitDesktop</span>
        </a>

        <!-- View toggle — mirrors the app's "hide AI features" setting -->
        <div
          class="flex items-center rounded-full border border-line-2 bg-surface p-0.5 text-xs"
          role="group"
          aria-label="Choose how much to show"
        >
          <button
            type="button"
            data-mode-btn="ai"
            aria-pressed="true"
            class="flex items-center gap-1 rounded-full px-3 py-1 text-muted transition-colors aria-pressed:bg-surface-2 aria-pressed:text-ink"
          >
            <span class="text-mint" aria-hidden="true">✦</span> AI-native
          </button>
          <button
            type="button"
            data-mode-btn="git"
            aria-pressed="false"
            class="rounded-full px-3 py-1 text-muted transition-colors aria-pressed:bg-surface-2 aria-pressed:text-ink"
          >
            Just Git
          </button>
        </div>

        <div class="flex items-center gap-1 text-sm">
          <a href={repo} class="hidden rounded px-3 py-1.5 text-muted transition-colors hover:text-ink sm:block">GitHub</a>
          <a
            href={download}
            class="ml-1 rounded-md bg-mint px-3.5 py-1.5 font-medium text-mint-ink transition-opacity hover:opacity-90"
            >Download</a
          >
        </div>
      </nav>
    </header>

    <main id="top">
      <!-- ============================ AI-NATIVE VIEW ======================= -->
      <div data-view="ai">
        <!-- Hero -->
        <section class="relative overflow-hidden border-b border-line">
          <div class="grid-bg pointer-events-none absolute inset-0"></div>
          <div
            class="relative mx-auto grid max-w-6xl items-center gap-x-12 gap-y-14 px-5 py-20 md:py-28 lg:grid-cols-[1fr_1.12fr]"
          >
            <div class="min-w-0">
              <p data-reveal class="mb-6 text-sm text-faint" style="transition-delay:0ms">
                <span class="text-add">//</span> an AI-native desktop client for GitHub
              </p>
              <h1
                data-reveal
                style="transition-delay:60ms"
                class="text-[clamp(2.25rem,5vw,3.5rem)] font-semibold tracking-tight"
              >
                The whole loop,<br class="hidden sm:block" /> one window.
              </h1>
              <p
                data-reveal
                style="transition-delay:120ms"
                class="mt-7 max-w-[58ch] text-base leading-relaxed text-body sm:text-lg"
              >
                The whole daily loop in one window: GitHub&nbsp;Desktop fundamentals,
                the full pull-request loop, Actions, and issues — plus AI that reads
                your diff for commits, PR descriptions, and code review, on your own
                models. Native, fast, and built to be trusted with uncommitted work.
              </p>
              <div
                data-reveal
                style="transition-delay:180ms"
                class="mt-9 flex flex-wrap items-center gap-3"
              >
                <a
                  href={download}
                  data-dl
                  class="rounded-lg bg-mint px-5 py-2.5 font-medium text-mint-ink transition-opacity hover:opacity-90"
                  ><span data-dl-label>Download for free</span></a
                >
                <a
                  href={repo}
                  class="rounded-lg border border-line-2 px-5 py-2.5 font-medium text-ink transition-colors hover:bg-surface"
                  >View on GitHub</a
                >
              </div>
              <p data-reveal style="transition-delay:240ms" class="mt-6 text-sm text-muted">
                <span data-dl-version></span>Windows, macOS &amp; Linux · Apache-2.0 ·
                <button type="button" data-mode-btn="git" class="text-mint underline-offset-4 hover:underline">
                  not into AI? hide it →
                </button>
              </p>
            </div>

            <div data-reveal style="transition-delay:220ms" class="mint-glow relative min-w-0">
              <figure class="window">
                <Image
                  src={appDiff}
                  alt="GitDesktop staging a TypeScript diff line by line, with an AI-generated commit message in the composer"
                  widths={[600, 900, 1296]}
                  sizes="(min-width: 1024px) 620px, 92vw"
                  format="webp"
                  quality={82}
                  loading="eager"
                  fetchpriority="high"
                />
              </figure>
            </div>
          </div>
        </section>

        <!-- AI: generate -->
        <section class="border-b border-line">
          <div
            class="mx-auto grid max-w-6xl items-center gap-x-14 gap-y-10 px-5 py-20 md:py-28 lg:grid-cols-[1.1fr_0.9fr]"
          >
            <div data-reveal class="order-2 min-w-0 lg:order-1">
              <figure class="window mx-auto max-w-sm lg:mx-0">
                <Image
                  src={appCommit}
                  alt="The commit composer with an AI-generated conventional-commit message describing the staged change"
                  widths={[340, 384]}
                  sizes="(min-width: 1024px) 360px, 80vw"
                  format="webp"
                  quality={84}
                />
              </figure>
            </div>
            <div data-reveal class="order-1 min-w-0 lg:order-2">
              <h2 class="text-balance text-3xl tracking-[-0.02em] sm:text-4xl">
                It writes the commit.<br class="hidden sm:block" /> You keep the keys.
              </h2>
              <p class="mt-6 max-w-[60ch] leading-relaxed text-body">
                One click reads your staged diff and drafts the commit message — and
                the PR title and description — in your conventions. It streams into
                the same fields you'd type in, so it's always editable and never
                blocks the manual path.
              </p>
              <p class="mt-4 max-w-[60ch] leading-relaxed text-muted">
                Bring your own model: Anthropic, OpenAI, any OpenAI-compatible
                endpoint (Vercel AI Gateway, Gemini, DeepSeek, Mistral, Z.ai),
                OpenRouter, Ollama (local, LAN, or cloud), or your
                Claude&nbsp;/&nbsp;Codex&nbsp;/&nbsp;Copilot&nbsp;/&nbsp;opencode
                CLI. No keys go to us — they're yours, stored in your OS keychain.
              </p>
            </div>
          </div>
        </section>

        <!-- AI: review -->
        <section class="border-b border-line bg-surface/30">
          <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
            <div data-reveal class="max-w-2xl">
              <div class="rule-mint mb-6 w-16"></div>
              <h2 class="text-balance text-3xl tracking-[-0.02em] sm:text-4xl">
                A reviewer that actually reads the code.
              </h2>
              <p class="mt-6 leading-relaxed text-body">
                Run a general review or a security audit on any pull request — local
                or on GitHub. It reads the changed files, flags real issues with a
                severity, and cites the exact lines. The result stays on your machine
                unless you choose to post it — and it keeps running while you move
                between PRs, or even after you close the window, then pings you when
                it's done.
              </p>
              <p class="mt-4 leading-relaxed text-muted">
                Turn on <span class="text-ink">Agentic review</span> and the reviewer
                pulls the full diff past the prompt budget, reads any file at any ref,
                searches the repo, and runs history — read-only end to end, so
                it can explore but never modify. It works with CLI agent models (via
                GitDesktop's read-only MCP server) and with API models through a native
                tool loop, which needs no review workspace and so starts instantly.
              </p>
            </div>
            <figure data-reveal style="transition-delay:120ms" class="window mt-10">
              <Image
                src={appReview}
                alt="An AI code review on a local pull request: should-fix and nit findings with code references and an inline severity"
                widths={[760, 1040, 1296]}
                sizes="(min-width: 1100px) 1000px, 94vw"
                format="webp"
                quality={82}
              />
            </figure>
          </div>
        </section>

        <!-- Local PRs (AI framing: the dialog with AI-drafted description) -->
        <FeatureRow
          title="Pull requests. Without the browser — or the cloud."
          image={appPrDialog}
          alt="The New local pull request dialog: merge one branch into another and review it locally, with an AI-generated description"
          side="right"
          widths={[540, 677]}
          sizes="(min-width: 1024px) 520px, 90vw"
        >
          <p>
            Open GitHub pull requests through <code class="text-ink">gh</code>, or
            private <span class="text-ink">local PRs</span> that never leave your
            machine: propose a merge, draft the description, review the diff, and
            merge with a <code class="text-ink">--no-ff</code> commit.
          </p>
          <p class="text-muted">
            The whole review loop — proposal, AI review, approval, merge — offline,
            on a repo that isn't on GitHub at all.
          </p>
        </FeatureRow>

        <!-- Issues + Discussions (collaboration; shown in both views) -->
        <FeatureRow
          title="Issues and to-dos, triaged in place."
          image={appIssues}
          alt="An issue in GitDesktop: a bug report with labels, an assignee, a linked pull request in the Development panel, and a comment thread"
          side="left"
        >
          <p>
            Browse, open, and edit GitHub issues without the tab-switch. Labels,
            assignees, milestones, issue type, sub-issues, dependencies, and the
            pull requests and branches that close them all sit in one panel.
          </p>
          <p class="text-muted">
            Working privately? Keep <span class="text-ink">local to-dos</span>
            that need no remote, then publish them to GitHub when the work goes
            public.
          </p>
        </FeatureRow>

        <FeatureRow
          title="Discussions, where the thread lives."
          image={appDiscussions}
          alt="A GitHub Discussion in GitDesktop: a roadmap thread with a category, an upvote count, reactions, and a threaded reply"
          side="right"
          surface={true}
        >
          <p>
            Read and join your repository's GitHub Discussions in the same
            window: categories, upvotes, reactions, and threaded replies, with
            the Write/Preview markdown you author everywhere else.
          </p>
          <p class="text-muted">
            Announcements, Q&amp;A, and roadmap threads, no browser tab required.
          </p>
        </FeatureRow>

        <!-- Daily loop -->
        <section class="border-b border-line">
          <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
            <h2 data-reveal class="max-w-2xl text-balance text-3xl tracking-[-0.02em] sm:text-4xl">
              And the rest of the daily loop.
            </h2>
            <div class="mt-14 grid items-center gap-x-14 gap-y-8 lg:grid-cols-2">
              <div data-reveal class="min-w-0">
                <h3 class="text-xl text-ink">Stage exactly what you mean.</h3>
                <p class="mt-4 max-w-[52ch] leading-relaxed text-body">
                  Stage — or discard — by file, by hunk, or by dragging across
                  individual lines, even within a brand-new file, to split a messy
                  working tree into clean, reviewable commits, with partial patches
                  applied via git's own <code class="text-ink">--cached</code>.
                </p>
              </div>
              <figure data-reveal style="transition-delay:80ms" class="window min-w-0">
                <Image
                  src={appStaging}
                  alt="A split diff with per-hunk stage controls and a hint to drag across lines to stage just those lines"
                  widths={[560, 860, 1296]}
                  sizes="(min-width: 1024px) 540px, 94vw"
                  format="webp"
                  quality={82}
                />
              </figure>
            </div>
            <div class="mt-16 grid items-center gap-x-14 gap-y-8 lg:grid-cols-2">
              <figure data-reveal class="window order-2 min-w-0 lg:order-1">
                <Image
                  src={appHistory}
                  alt="Browsing commit history with a selected commit's changed files and a syntax-highlighted diff"
                  widths={[560, 860, 1296]}
                  sizes="(min-width: 1024px) 540px, 94vw"
                  format="webp"
                  quality={82}
                />
              </figure>
              <div data-reveal style="transition-delay:80ms" class="order-1 min-w-0 lg:order-2">
                <h3 class="text-xl text-ink">Read the whole story.</h3>
                <p class="mt-4 max-w-[52ch] leading-relaxed text-body">
                  Browse history, search every commit, and blame any line back to the
                  change that introduced it — then cherry-pick, squash, reorder, or
                  stash, without leaving the keyboard.
                </p>
              </div>
            </div>
          </div>
        </section>

