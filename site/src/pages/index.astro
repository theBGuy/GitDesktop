    <script is:inline>
      // View toggle: AI-native <-> Just Git. Persisted + reflected in ?ai=off.
      (function () {
        var root = document.documentElement;
        var btns = Array.prototype.slice.call(document.querySelectorAll("[data-mode-btn]"));
        function sync(git) {
          btns.forEach(function (b) {
            if (b.hasAttribute("aria-pressed")) {
              b.setAttribute("aria-pressed", String((b.getAttribute("data-mode-btn") === "git") === git));
            }
          });
        }
        sync(root.classList.contains("mode-git"));
        btns.forEach(function (b) {
          b.addEventListener("click", function () {
            var git = b.getAttribute("data-mode-btn") === "git";
            root.classList.toggle("mode-git", git);
            sync(git);
            try { localStorage.setItem("gd-view", git ? "git" : "ai"); } catch (e) {}
            var url = new URL(location.href);
            if (git) url.searchParams.set("ai", "off");
            else url.searchParams.delete("ai");
            history.replaceState(null, "", url);
            window.scrollTo({ top: 0 });
          });
        });
      })();
    </script>

    <script is:inline>
      // OS-aware download CTAs + current-version badge. Labels the primary
      // buttons for the visitor's OS (Windows/Linux — the platforms we ship)
      // and fills the version + direct asset links from the latest GitHub
      // release. Degrades to the /download hub with no JS or no release.
      (function () {
        var OWNER = "theBGuy";
        var REPO = "GitDesktop";
        var ua = navigator.userAgent || "";
        var plat =
          (navigator.userAgentData && navigator.userAgentData.platform) ||
          navigator.platform ||
          "";
        var hay = plat + " " + ua;
        var os = /Win/i.test(hay)
          ? "windows"
          : /Mac/i.test(hay)
            ? "macos"
            : /Linux|X11/i.test(hay) && !/Android/i.test(ua)
              ? "linux"
              : "other";
        var suffix = { windows: "-setup.exe", macos: ".dmg", linux: ".AppImage" };
        var label = {
          windows: "Download for Windows",
          macos: "Download for macOS",
          linux: "Download for Linux",
        };
        var btns = document.querySelectorAll("[data-dl]");
        if (label[os]) {
          document.querySelectorAll("[data-dl-label]").forEach(function (el) {
            el.textContent = label[os];
          });
        }
        fetch(
          "https://api.github.com/repos/" + OWNER + "/" + REPO + "/releases/latest",
          { headers: { Accept: "application/vnd.github+json" } }
        )
          .then(function (r) {
            if (!r.ok) throw 0;
            return r.json();
          })
          .then(function (rel) {
            if (rel.tag_name) {
              document
                .querySelectorAll("[data-dl-version]")
                .forEach(function (el) {
                  el.textContent = rel.tag_name + " · ";
                });
            }
            if (suffix[os]) {
              var assets = rel.assets || [];
              var s = suffix[os];
              var url = null;
              for (var i = 0; i < assets.length; i++) {
                var n = assets[i].name || "";
                if (
                  n.length >= s.length &&
                  n.slice(-s.length) === s &&
                  n.indexOf(".sig") === -1
                ) {
                  url = assets[i].browser_download_url;
                  break;
                }
              }
              if (url)
                btns.forEach(function (b) {
                  b.href = url;
                });
            }
          })
          .catch(function () {});
      })();
    </script>
