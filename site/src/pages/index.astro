      <div data-reveal style="transition-delay:80ms" class="min-w-0">
        <figure class="window">
          <McpConfig />
        </figure>
        <ul class="ladder mt-4">
          <li data-default>
            <span class="tier">default</span>
            <span>Read-only — status, log, diff, blame, PRs, issues, CI</span>
          </li>
          <li>
            <span class="tier">--allow-write</span>
            <span>Local PRs &amp; issues (GitDesktop's own review artifacts)</span>
          </li>
          <li>
            <span class="tier">--allow-remote-write</span>
            <span>Real forge writes under your authenticated identity</span>
          </li>
          <li>
            <span class="tier">--allow-git-write</span>
            <span>Recoverable git ops — stage, commit, branch, push</span>
