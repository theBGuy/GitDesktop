---
// The single <head> for every page on the site. Both layouts render this, which
// is the entire point: SiteLayout and Layout had already drifted (the download
// and legal pages never got the skip link, and neither head had a canonical),
// and letting the blog hand-roll a third head would have tripled that drift.
//
// Every URL-shaped tag derives from Astro.site + the current pathname, so
// nothing here can go stale when a route moves.
import jetbrainsMonoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import { canonicalSentence } from "../lib/brand";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Site-relative or absolute. Defaults to the product card. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  /** Emitted only when ogType is "article". */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** With ogType "article" + publishedTime, adds a BlogPosting JSON-LD node. */
  articleAuthor?: string;
  /** Overrides the derived canonical — syndicated reposts only. */
  canonical?: string;
  /** Adds the RSS autodiscovery link. Blog surfaces only. */
  feed?: boolean;
  /** Trail below Home, e.g. [{ name: "Blog", path: "/blog/" }]. */
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = "/og-default.png",
  ogImageAlt = "GitDesktop — a Git client showing a pull request with CI checks and an AI code review",
  ogType = "website",
  publishedTime,
  modifiedTime,
  articleAuthor,
  canonical,
  feed = false,
  breadcrumbs,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site!;

// Site-relative paths get the base joined (a no-op at base "/") so every URL
// this head emits agrees with canonicalUrl under the documented /GitDesktop/
// base contingency; already-composed helper output passes through untouched.
const withBase = (p: string) =>
  p.startsWith(base)
    ? p
    : base.replace(/\/$/, "") + (p.startsWith("/") ? p : `/${p}`);

// The site's front door WITH the base — the anchor for every URL that means
// "this site" rather than a path on it (Organization/WebSite url, the Home
// crumb, and the #fragment @ids). site.href alone would name the account
// root under the /GitDesktop/ contingency.
const homeUrl = new URL(base, site).href;

// Canonical from the PATH ONLY. Dropping the query string is what collapses the
// ?ai=off / ?ai=0 view-toggle variants of every page onto a single URL — the
// toggle rewrites the querystring via history.replaceState, so without this
// every page has three crawlable spellings. (Astro.url.pathname already
// carries the base, so no withBase here.)
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;
// ogImage may be absolute ("https://…") — only site-relative values compose.
const ogImageUrl = /^https?:/i.test(ogImage)
  ? ogImage
  : new URL(withBase(ogImage), site).href;

// Endpoints with a file extension 404 on a trailing slash in Astro 6, and
// Cloudflare only ADDS slashes to extension-less paths — so these two must stay
// slash-less even though every page route carries one.
const sitemapUrl = new URL(withBase("/sitemap-index.xml"), site).href;
const feedUrl = new URL(withBase("/rss.xml"), site).href;

// Entity / knowledge-graph work, deliberately NOT rich-result chasing: no
// FAQPage (rich results removed sitewide 2026-05-07), no aggregateRating (no
// honest rating source; fabricating one violates structured-data policy).
const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": new URL("#organization", homeUrl).href,
    name: "GitDesktop",
    url: homeUrl,
    logo: new URL(withBase("/app-icon.svg"), site).href,
    description: canonicalSentence,
    sameAs: ["https://github.com/theBGuy/GitDesktop"],
  },
  {
    "@type": "WebSite",
    "@id": new URL("#website", homeUrl).href,
    name: "GitDesktop",
    url: homeUrl,
    publisher: { "@id": new URL("#organization", homeUrl).href },
  },
];

if (breadcrumbs && breadcrumbs.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
      ...breadcrumbs.map((crumb, i) => ({
        "@type": "ListItem",
        position: i + 2,
        name: crumb.name,
        item: new URL(withBase(crumb.path), site).href,
      })),
    ],
  });
}

// Posts get the one node type that actually benefits them. Gated on the same
// article signals PostLayout already sends; publisher reuses the Organization
// node by @id rather than duplicating it.
if (ogType === "article" && publishedTime) {
  graph.push({
    "@type": "BlogPosting",
    headline: ogTitle,
    description: ogDescription,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    image: ogImageUrl,
    datePublished: publishedTime.toISOString(),
    dateModified: (modifiedTime ?? publishedTime).toISOString(),
    ...(articleAuthor && {
      author: { "@type": "Person", name: articleAuthor },
    }),
    publisher: { "@id": new URL("#organization", homeUrl).href },
  });
}

// <-escaped so content containing a literal "</script>" (a post title,
// say) can't terminate the inline JSON-LD block early.
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
}).replace(/</g, "\\u003c");
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${base}app-icon.svg`} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{/* --color-bg, oklch(0.145 0 0), converted rather than eyeballed. */}
<meta name="theme-color" content="#0a0a0a" />

{/*
  The latin body face — without this it's discovered via the CSS @import chain,
  ~11th on the network. Cloudflare Pages Early Hints auto-promotes preloads on
  custom domains into a 103 response. Imported as an asset so the href always
  carries the current content hash; crossorigin is required for fonts even
  same-origin.
*/}
<link rel="preload" as="font" type="font/woff2" href={jetbrainsMonoLatin} crossorigin />

<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="GitDesktop" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

{
  ogType === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
  )
}
{
  ogType === "article" && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime.toISOString()} />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<link rel="sitemap" type="application/xml" href={sitemapUrl} />
{feed && <link rel="alternate" type="application/rss+xml" title="GitDesktop blog" href={feedUrl} />}

<script type="application/ld+json" is:inline set:html={jsonLd} />
