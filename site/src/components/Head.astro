---
// The single <head> for every page on the site. Both layouts render this, which
// is the entire point: SiteLayout and Layout had already drifted (the download
// and legal pages never got the skip link, and neither head had a canonical),
// and letting the blog hand-roll a third head would have tripled that drift.
//
// Every URL-shaped tag derives from Astro.site + the current pathname, so
// nothing here can go stale when a route moves.
import jetbrainsMonoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Site-relative or absolute. Defaults to the product card. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  /** Emitted only when ogType is "article". */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Overrides the derived canonical — syndicated reposts only. */
  canonical?: string;
  /** Adds the RSS autodiscovery link. Blog surfaces only. */
  feed?: boolean;
  /** Trail below Home, e.g. [{ name: "Blog", path: "/blog/" }]. */
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = "/og-default.png",
  ogImageAlt = "GitDesktop — a native Git client showing a pull request with CI checks and an AI code review",
  ogType = "website",
  publishedTime,
  modifiedTime,
  canonical,
  feed = false,
  breadcrumbs,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site!;

// Canonical from the PATH ONLY. Dropping the query string is what collapses the
// ?ai=off / ?ai=0 view-toggle variants of every page onto a single URL — the
// toggle rewrites the querystring via history.replaceState, so without this
// every page has three crawlable spellings.
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;

// Endpoints with a file extension 404 on a trailing slash in Astro 6, and
// Cloudflare only ADDS slashes to extension-less paths — so these two must stay
// slash-less even though every page route carries one.
const sitemapUrl = new URL("sitemap-index.xml", site).href;
const feedUrl = new URL("rss.xml", site).href;

// The one canonical description sentence, repeated verbatim wherever the
// project describes itself (homepage footer, README, GitHub About, releases).
// "GitDesktop" collides with GitHub Desktop and a discontinued macOS client at
// gitdesktop.com, so every clause is a discriminator no competitor shares.
const canonicalSentence =
  "GitDesktop is a free, open-source (Apache-2.0) desktop Git client for " +
  "Windows, macOS, and Linux, built with Tauri 2 and React 19 by theBGuy. " +
  "It works with GitHub, GitLab, and Bitbucket — staging, diffs, branches, " +
  "history, and the full pull-request loop with code review, CI, and issues " +
  "— with optional AI you can hide entirely.";

// Entity / knowledge-graph work, deliberately NOT rich-result chasing: no
// FAQPage (rich results removed sitewide 2026-05-07), no aggregateRating (no
// honest rating source; fabricating one violates structured-data policy).
const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": new URL("#organization", site).href,
    name: "GitDesktop",
    url: site.href,
    logo: new URL("app-icon.svg", site).href,
    description: canonicalSentence,
    sameAs: ["https://github.com/theBGuy/GitDesktop"],
  },
  {
    "@type": "WebSite",
    "@id": new URL("#website", site).href,
    name: "GitDesktop",
    url: site.href,
    publisher: { "@id": new URL("#organization", site).href },
  },
];

if (breadcrumbs && breadcrumbs.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.href },
      ...breadcrumbs.map((crumb, i) => ({
        "@type": "ListItem",
        position: i + 2,
        name: crumb.name,
        item: new URL(crumb.path, site).href,
      })),
    ],
  });
}

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
});
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${base}app-icon.svg`} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{/* --color-bg, oklch(0.145 0 0), converted rather than eyeballed. */}
<meta name="theme-color" content="#0a0a0a" />

{/*
  The latin body face — without this it's discovered via the CSS @import chain,
  ~11th on the network. Cloudflare Pages Early Hints auto-promotes preloads on
  custom domains into a 103 response. Imported as an asset so the href always
  carries the current content hash; crossorigin is required for fonts even
  same-origin.
*/}
<link rel="preload" as="font" type="font/woff2" href={jetbrainsMonoLatin} crossorigin />

<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="GitDesktop" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

{
  ogType === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
  )
}
{
  ogType === "article" && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime.toISOString()} />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<link rel="sitemap" type="application/xml" href={sitemapUrl} />
{feed && <link rel="alternate" type="application/rss+xml" title="GitDesktop blog" href={feedUrl} />}

<script type="application/ld+json" is:inline set:html={jsonLd} />