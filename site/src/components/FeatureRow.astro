---
import { Image } from "astro:assets";
import DemoVideo from "./DemoVideo.astro";

/** Exactly one visual: a still screenshot or a demo loop (see DemoVideo). */
type Visual =
  | { image: ImageMetadata; video?: never }
  | {
      video: { name: string; width: number; height: number; posterAt: number };
      image?: never;
    };

type Props = Visual & {
  title: string;
  /** The screenshot's alt text, or the demo loop's label. */
  alt: string;
  /** Which side the visual sits on at desktop width. */
  side?: "left" | "right";
  /** eager, sizes, and widths apply to `image` only. */
  eager?: boolean;
  sizes?: string;
  widths?: number[];
  surface?: boolean;
  /** Stable anchor so posts and comparison pages can deep-link the section. */
  id?: string;
};

const {
  title,
  image,
  video,
  alt,
  side = "right",
  eager = false,
  sizes = "(min-width: 1024px) 540px, 94vw",
  widths = [560, 860, 1296],
  surface = false,
  id,
} = Astro.props;

// `astro build` doesn't type-check, so the union above needs a build-time twin.
if (!image === !video) {
  throw new Error(`FeatureRow "${title}": pass exactly one of image or video.`);
}

// Text always reads first on mobile; the visual's side only matters at lg+.
const visualOrder = side === "left" ? "order-2 lg:order-1" : "order-2";
const txtOrder = side === "left" ? "order-1 lg:order-2" : "order-1";
---

<section
  id={id}
  class:list={["border-b border-line", surface && "bg-surface/30", id && "scroll-mt-20"]}
>
  <div
    class="mx-auto grid max-w-6xl items-center gap-x-14 gap-y-10 px-5 py-20 md:py-28 lg:grid-cols-2"
  >
    <div data-reveal class:list={["min-w-0", txtOrder]}>
      <h2 class="text-balance text-3xl tracking-[-0.02em] sm:text-4xl">{title}</h2>
      <div class="mt-6 max-w-[58ch] space-y-4 leading-relaxed text-body">
        <slot />
      </div>
    </div>
    {
      video ? (
        <DemoVideo
          name={video.name}
          label={alt}
          width={video.width}
          height={video.height}
          posterAt={video.posterAt}
          class:list={["min-w-0", visualOrder]}
          style="transition-delay:80ms"
        />
      ) : (
        image && (
          <figure
            data-reveal
            style="transition-delay:80ms"
            class:list={["window min-w-0", visualOrder]}
          >
            <Image
              src={image}
              alt={alt}
              widths={widths}
              sizes={sizes}
              format="webp"
              quality={82}
              loading={eager ? "eager" : "lazy"}
            />
          </figure>
        )
      )
    }
  </div>
</section>
