---
import { Image } from "astro:assets";

interface Props {
  title: string;
  image: ImageMetadata;
  alt: string;
  /** Which side the screenshot sits on at desktop width. */
  side?: "left" | "right";
  eager?: boolean;
  sizes?: string;
  widths?: number[];
  surface?: boolean;
  /** Stable anchor so posts and comparison pages can deep-link the section. */
  id?: string;
}

const {
  title,
  image,
  alt,
  side = "right",
  eager = false,
  sizes = "(min-width: 1024px) 540px, 94vw",
  widths = [560, 860, 1296],
  surface = false,
  id,
} = Astro.props;

// Text always reads first on mobile; image side only matters at lg+.
const imgOrder = side === "left" ? "order-2 lg:order-1" : "order-2";
const txtOrder = side === "left" ? "order-1 lg:order-2" : "order-1";
---

<section
  id={id}
  class:list={["border-b border-line", surface && "bg-surface/30", id && "scroll-mt-20"]}
>
  <div
    class="mx-auto grid max-w-6xl items-center gap-x-14 gap-y-10 px-5 py-20 md:py-28 lg:grid-cols-2"
  >
    <div data-reveal class:list={["min-w-0", txtOrder]}>
      <h2 class="text-balance text-3xl tracking-[-0.02em] sm:text-4xl">{title}</h2>
      <div class="mt-6 max-w-[58ch] space-y-4 leading-relaxed text-body">
        <slot />
      </div>
    </div>
    <figure
      data-reveal
      style="transition-delay:80ms"
      class:list={["window min-w-0", imgOrder]}
    >
      <Image
        src={image}
        alt={alt}
        widths={widths}
        sizes={sizes}
        format="webp"
        quality={82}
        loading={eager ? "eager" : "lazy"}
      />
    </figure>
  </div>
</section>
